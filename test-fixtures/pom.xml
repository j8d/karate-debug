<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.j8d.karate</groupId>
    <artifactId>test-fixtures</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Using Karate fork with GraalVM 25.0.2 for compatibility with chromeinspector/dap-tool -->
        <karate.version>v1.5.2-j8d.3</karate.version>
    </properties>

    <dependencies>
        <!-- Karate Core - using instrumented fork from j8d-org for CI debugging -->
        <dependency>
            <groupId>com.github.j8d-org.karate</groupId>
            <artifactId>karate-core</artifactId>
            <version>${karate.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.j8d-org.karate</groupId>
            <artifactId>karate-junit5</artifactId>
            <version>${karate.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- GraalVM Chrome Inspector - enables JavaScript debugging via Chrome DevTools Protocol -->
        <!-- Must match the GraalJS version used by Karate (24.0.0 for Karate 1.5.2) -->
        <dependency>
            <groupId>org.graalvm.tools</groupId>
            <artifactId>chromeinspector-tool</artifactId>
            <version>25.0.2</version>
            <scope>test</scope>
        </dependency>

        <!-- GraalVM DAP Tool - enables JavaScript debugging via Debug Adapter Protocol -->
        <!-- Alternative to Chrome Inspector, uses native DAP instead of CDP -->
        <dependency>
            <groupId>org.graalvm.tools</groupId>
            <artifactId>dap-tool</artifactId>
            <version>25.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- JitPack repository for instrumented Karate fork -->
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/java</directory>
                <includes>
                    <include>**/*.feature</include>
                    <include>**/*.json</include>
                    <include>**/*.js</include>
                </includes>
            </testResource>
        </testResources>
    </build>
</project>
