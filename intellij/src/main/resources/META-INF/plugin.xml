<idea-plugin url="https://karatedebug.com">
    <id>com.j8d.karate-debug</id>
    <name>Karate Debug</name>
    <vendor email="ryan@karatedebug.com" url="https://karatedebug.com">j8d</vendor>

    <!-- Plugin dependencies -->
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <!-- Explicitly exclude Aqua IDE (it has com.intellij.modules.java but we don't support it) -->
    <incompatible-with>com.intellij.modules.aqua</incompatible-with>

    <extensions defaultExtensionNs="com.intellij">
        <!-- License manager (application-level) -->
        <applicationService
            serviceImplementation="com.j8d.karate.intellij.licensing.LicenseManager"/>

        <!-- REST service for OAuth callback (uses built-in IDE HTTP server) -->
        <httpRequestHandler
            implementation="com.j8d.karate.intellij.licensing.KarateAuthRestService"/>

        <!-- Karate file type -->
        <fileType
            name="Karate Feature"
            implementationClass="com.j8d.karate.intellij.lang.KarateFileType"
            fieldName="INSTANCE"
            language="Karate"
            extensions="feature"/>

        <!-- Karate language -->
        <lang.parserDefinition
            language="Karate"
            implementationClass="com.j8d.karate.intellij.lang.KarateParserDefinition"/>

        <!-- Syntax highlighter -->
        <lang.syntaxHighlighterFactory
            language="Karate"
            implementationClass="com.j8d.karate.intellij.lang.KarateSyntaxHighlighterFactory"/>

        <!-- Karate project detection -->
        <projectService
            serviceImplementation="com.j8d.karate.intellij.project.KarateProjectService"/>

        <!-- Karate project settings (persistent) -->
        <projectService
            serviceImplementation="com.j8d.karate.intellij.project.KarateProjectSettings"/>

        <!-- Build file listener for auto-refresh -->
        <projectService
            serviceImplementation="com.j8d.karate.intellij.project.KarateBuildFileListener"/>

        <!-- Match diagnostics registry for storing failure info -->
        <projectService
            serviceImplementation="com.j8d.karate.intellij.debug.MatchDiagnosticsRegistry"/>

        <!-- Startup activity to detect Karate projects -->
        <postStartupActivity
            implementation="com.j8d.karate.intellij.project.KarateProjectStartupActivity"/>

        <!-- Run line marker provider for gutter icons -->
        <runLineMarkerContributor
            language="Karate"
            implementationClass="com.j8d.karate.intellij.run.KarateRunLineMarkerContributor"/>

        <!-- Run configuration type -->
        <configurationType
            implementation="com.j8d.karate.intellij.run.KarateConfigurationType"/>

        <!-- Run configuration producer (auto-generate configs) -->
        <runConfigurationProducer
            implementation="com.j8d.karate.intellij.run.KarateRunConfigurationProducer"/>

        <!-- Debug program runner -->
        <programRunner
            implementation="com.j8d.karate.intellij.debug.KarateDebugProgramRunner"/>

        <!-- Run program runner - redirects to debug (Karate Debug is debug-only) -->
        <programRunner
            implementation="com.j8d.karate.intellij.run.KarateRunProgramRunner"/>

        <!-- XDebugger support -->
        <xdebugger.breakpointType
            implementation="com.j8d.karate.intellij.debug.KarateBreakpointType"/>

        <!-- Tool window for Karate features -->
        <toolWindow
            id="Karate"
            anchor="left"
            secondary="true"
            icon="/icons/karate-13.svg"
            factoryClass="com.j8d.karate.intellij.ui.KarateToolWindowFactory"/>

        <!-- Notifications -->
        <notificationGroup
            id="Karate Debug"
            displayType="BALLOON"/>

        <!-- Settings page under Tools -->
        <projectConfigurable
            parentId="tools"
            instance="com.j8d.karate.intellij.settings.KarateSettingsConfigurable"
            id="com.j8d.karate.intellij.settings"
            displayName="Karate Debug"
            nonDefaultProject="true"/>

        <!-- Status bar widgets -->
        <statusBarWidgetFactory
            id="KarateEnvironment"
            implementation="com.j8d.karate.intellij.ui.KarateStatusBarWidgetFactory"
            order="after encodingWidget"/>
        <statusBarWidgetFactory
            id="KarateLogLevel"
            implementation="com.j8d.karate.intellij.ui.KarateLogLevelWidgetFactory"
            order="after KarateEnvironment"/>
        <statusBarWidgetFactory
            id="KarateLicense"
            implementation="com.j8d.karate.intellij.ui.KarateLicenseWidgetFactory"
            order="after KarateLogLevel"/>

        <!--
        Inlay hints for match actual values - DISABLED
        We now use direct inlay creation in MatchDiagnosticsService which supports clickable [Fix] buttons.
        <codeInsight.inlayProvider
            language="Karate"
            implementationClass="com.j8d.karate.intellij.debug.KarateInlayHintsProvider"/>
        -->
    </extensions>

    <actions>
        <!-- Debug action for Karate features (no Run - debug only for consistency with VS Code) -->
        <group id="KarateDebug.FeatureActions"
               text="Karate"
               description="Karate Debug actions">

            <action id="KarateDebug.DebugFeature"
                    class="com.j8d.karate.intellij.actions.DebugFeatureAction"
                    text="Debug Karate Feature"
                    description="Debug the current Karate feature file"
                    icon="AllIcons.Actions.StartDebugger"/>

            <add-to-group group-id="RunMenu" anchor="after" relative-to-action="RunClass"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </group>
    </actions>

    <!-- Intention actions (quick fixes) -->
    <extensions defaultExtensionNs="com.intellij">
        <intentionAction>
            <language>Karate</language>
            <className>com.j8d.karate.intellij.debug.MatchQuickFixIntention</className>
            <category>Karate</category>
        </intentionAction>
    </extensions>
</idea-plugin>

