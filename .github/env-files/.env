#######################################################
## These are common variables. Not environment specific
#######################################################

AWS_REGION_AMR=us-west-2
AWS_REGION_EU=eu-central-1
AWS_REGION_APAC=ap-northeast-1
AWS_REGION_CHINA=cn-north-1

# Name of the team yaml file in resmed/devx-github-teams-management/teams
DEPLOYMENT_REVIEWERS_YAML=

# Which service to deploy to. Possible values are [ECS-SERVICE, ECS-SCHEDULED, ON-DEMAND].
DEPLOYMENT_SERVICE_TYPE=ECS-SERVICE

JAVA_VERSION=11
SERVICE_NAME=
SPRING_PROFILE=

USE_SNAPSHOT_POM_VERSION=false
USE_SELF_HOSTED_RUNNER=false

AUTO_DEPLOY_DEVELOP=dev-amr
AUTO_DEPLOY_RELEASE=dev-amr