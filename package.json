{
  "name": "karate-debug",
  "displayName": "Karate Debug",
  "description": "Debug Karate tests",
  "version": "0.1.10",
  "publisher": "j8d",
  "license": "",
  "icon": "resources/karate-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/j8d/karate-debug"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers",
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:karate",
    "workspaceContains:**/*.feature"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "karate",
        "aliases": [
          "Karate",
          "karate"
        ],
        "extensions": [
          ".feature"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "karate",
        "scopeName": "source.karate",
        "path": "./syntaxes/karate.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "karate",
        "label": "Karate Debug",
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "feature"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "description": "Path to the feature file to debug",
                "default": "${file}"
              },
              "karateEnv": {
                "type": "string",
                "description": "Karate environment (karate.env)",
                "default": "dev"
              },
              "karateOptions": {
                "type": "string",
                "description": "Additional Karate CLI options",
                "default": ""
              },
              "javaDebugPort": {
                "type": "number",
                "description": "Port for Java debugger (JDWP). When set, enables simultaneous Java and Feature breakpoints. Use with a compound launch config to attach Java debugger.",
                "default": 0
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "karate",
            "request": "launch",
            "name": "Karate Debug",
            "feature": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Karate: Debug Feature",
            "description": "Debug a Karate feature file",
            "body": {
              "type": "karate",
              "request": "launch",
              "name": "Karate Debug",
              "feature": "^\"${1:\\${file}}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Karate Debug",
      "properties": {
        "karateDebug.karateEnv": {
          "type": "string",
          "default": "dev",
          "description": "Default Karate environment"
        },
        "karateDebug.javaHome": {
          "type": "string",
          "default": "",
          "description": "Path to Java home (uses system default if empty)"
        }
      }
    },
    "commands": [
      {
        "command": "karateDebug.debugFeature",
        "title": "Karate: Debug Scenario"
      },
      {
        "command": "karateDebug.debugEntireFeature",
        "title": "Karate: Debug Feature"
      },
      {
        "command": "karateDebug.selectEnvironment",
        "title": "Karate: Select Environment"
      },
      {
        "command": "karateDebug.refreshFeatures",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "karateDebug.openFeature",
        "title": "Open Feature"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "karate-explorer",
          "title": "Karate",
          "icon": "resources/karate-dark.svg"
        }
      ]
    },
    "views": {
      "karate-explorer": [
        {
          "id": "karateFeatures",
          "name": "Features"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "karateDebug.refreshFeatures",
          "when": "view == karateFeatures",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "karateDebug.debugEntireFeature",
          "when": "view == karateFeatures && viewItem == feature",
          "group": "inline"
        },
        {
          "command": "karateDebug.debugFeature",
          "when": "view == karateFeatures && viewItem == scenario",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.7.1",
    "glob": "^10.3.0",
    "mocha": "^10.2.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.64.0",
    "@vscode/debugprotocol": "^1.64.0"
  }
}
