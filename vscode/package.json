{
  "name": "karate-debug",
  "displayName": "Karate Debug",
  "description": "Debug Karate API tests with breakpoints, step-through debugging, and an integrated test explorer. Features CodeLens buttons, environment switching, and full Karate DSL syntax highlighting.",
  "version": "0.7.6",
  "publisher": "j8d",
  "author": {
    "name": "j8d"
  },
  "license": "SEE LICENSE IN LICENSE",
  "icon": "resources/karate-icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/j8d-org/karate-debug"
  },
  "bugs": {
    "email": "ryan@karatedebug.com"
  },
  "homepage": "https://marketplace.visualstudio.com/items?itemName=j8d.karate-debug",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers",
    "Testing"
  ],
  "keywords": [
    "karate",
    "api-testing",
    "automation",
    "test-automation",
    "api",
    "rest",
    "debug",
    "debugger",
    "bdd",
    "gherkin",
    "integration-testing",
    "functional-testing"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.feature",
    "onUri"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "languages": [
      {
        "id": "karate",
        "aliases": [
          "Karate",
          "karate"
        ],
        "extensions": [
          ".feature"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "karate",
        "scopeName": "source.karate",
        "path": "./syntaxes/karate.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "karate"
      }
    ],
    "debuggers": [
      {
        "type": "karate",
        "label": "Karate Debug",
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "feature"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "description": "Path to the feature file to debug",
                "default": "${file}"
              },
              "karateEnv": {
                "type": "string",
                "description": "Karate environment (karate.env)",
                "default": "dev"
              },
              "karateOptions": {
                "type": "string",
                "description": "Additional Karate CLI options",
                "default": ""
              },
              "javaDebugPort": {
                "type": "number",
                "description": "Port for Java debugger (JDWP). When set, enables simultaneous Java and Feature breakpoints. Use with a compound launch config to attach Java debugger.",
                "default": 0
              },
              "jsDebugPort": {
                "type": "number",
                "description": "[Experimental] Port for JavaScript debugger (Chrome DevTools Protocol). When set, enables debugging of embedded JavaScript in Karate tests. Connect Chrome DevTools or VS Code JS debugger to this port.",
                "default": 0
              },
              "enableJavaDebugging": {
                "type": "boolean",
                "description": "[Experimental] Enable Java debugging. When enabled, you can set breakpoints in Java code and step through Java methods called from Karate tests.",
                "default": false
              },
              "enableJsDebugging": {
                "type": "boolean",
                "description": "[Experimental] Enable JavaScript debugging. When enabled, you can set breakpoints in .js files and step through JavaScript functions called from Karate tests.",
                "default": false
              },
              "skipJdkClasses": {
                "type": "boolean",
                "description": "Skip JDK core classes (java.*, javax.*, jdk.*, sun.*, com.sun.*) when stepping in Java code. When enabled, stepping will automatically exit framework code and return to user code.",
                "default": true
              },
              "skipKarateFramework": {
                "type": "boolean",
                "description": "Skip Karate framework classes (com.intuit.karate.*) when stepping in Java code. Set to false to step into Karate source code for debugging.",
                "default": true
              },
              "skipKarateDependencies": {
                "type": "boolean",
                "description": "Skip Karate's third-party dependencies (com.jayway.jsonpath.*, io.netty.*, org.slf4j.*, etc.) when stepping in Java code. Set to false to step through all library code that Karate uses internally.",
                "default": true
              },
              "internalConsoleOptions": {
                "type": "string",
                "enum": [
                  "neverOpen",
                  "openOnFirstSessionStart",
                  "openOnSessionStart"
                ],
                "description": "Controls when the Debug Console should open. Use 'neverOpen' to keep focus on the Output tab.",
                "default": "neverOpen"
              },
              "javaSourcePaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Additional directories containing Java source files. Use this to enable inline variable display for JDK, Karate, or other library sources. Paths can be directories or .zip/.jar files containing sources.",
                "default": []
              },
              "autoDetectJdkSources": {
                "type": "boolean",
                "description": "Automatically detect and use JDK source files (src.zip) from the Java installation. Enables inline variable display when stepping into JDK classes.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "karate",
            "request": "launch",
            "name": "1. Karate: Start with Java Debug",
            "feature": "${file}",
            "javaDebugPort": 5006
          },
          {
            "type": "java",
            "request": "attach",
            "name": "2. Java: Attach to Karate",
            "hostName": "localhost",
            "port": 5006,
            "timeout": 30000
          },
          {
            "type": "karate",
            "request": "launch",
            "name": "Karate: Debug Feature Only",
            "feature": "${file}"
          },
          {
            "type": "karate",
            "request": "launch",
            "name": "Karate: Polyglot Debug (Karate + JS + Java)",
            "feature": "${file}",
            "enableJavaDebugging": true,
            "enableJsDebugging": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Karate: Debug Feature Only",
            "description": "Debug a Karate feature file without Java debugging",
            "body": {
              "type": "karate",
              "request": "launch",
              "name": "Karate: Debug Feature Only",
              "feature": "^\"${1:\\${file}}\""
            }
          },
          {
            "label": "Karate: Start with Java Debug",
            "description": "Debug Karate features with Java debugger attachment",
            "body": {
              "type": "karate",
              "request": "launch",
              "name": "1. Karate: Start with Java Debug",
              "feature": "^\"${1:\\${file}}\"",
              "javaDebugPort": 5006
            }
          },
          {
            "label": "Java: Attach to Karate",
            "description": "Attach Java debugger to running Karate debug session",
            "body": {
              "type": "java",
              "request": "attach",
              "name": "2. Java: Attach to Karate",
              "hostName": "localhost",
              "port": 5006,
              "timeout": 30000
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Karate Debug",
      "properties": {
        "karateDebug.environments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "dev",
            "qa",
            "stage"
          ],
          "description": "List of available Karate environments"
        },
        "karateDebug.defaultEnvironment": {
          "type": "string",
          "default": "dev",
          "description": "Default Karate environment to use"
        },
        "karateDebug.javaHome": {
          "type": "string",
          "default": "",
          "description": "Path to Java home (uses system default if empty)"
        },
        "karateDebug.matchDiagnostics.showPassing": {
          "type": "boolean",
          "default": true,
          "description": "Show green underlines for passing match statements"
        },
        "karateDebug.matchDiagnostics.showFailing": {
          "type": "boolean",
          "default": true,
          "description": "Show red underlines for failing match statements"
        },
        "karateDebug.matchDiagnostics.showActualValues": {
          "type": "boolean",
          "default": true,
          "description": "Show actual values and Fix button next to failing match statements"
        },
        "karateDebug.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Log level for Karate Debug output"
        },
        "karateDebug.logFilter.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "THYMELEAF"
          ],
          "description": "Log lines containing any of these strings will be hidden from output."
        },
        "karateDebug.logBreakpoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Pause execution when any of these strings appear in log output (e.g., 'NullPointerException', 'ERROR')."
        }
      }
    },
    "commands": [
      {
        "command": "karateDebug.debugFeature",
        "title": "Karate Debug: Debug Scenario"
      },
      {
        "command": "karateDebug.debugEntireFeature",
        "title": "Karate Debug: Debug Feature"
      },
      {
        "command": "karateDebug.selectEnvironment",
        "title": "Karate Debug: Select Environment"
      },
      {
        "command": "karateDebug.refreshFeatures",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "karateDebug.openFeature",
        "title": "Open Feature"
      },
      {
        "command": "karateDebug.openSettings",
        "title": "Karate Debug: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "karateDebug.login",
        "title": "Karate Debug: Sign In with GitHub"
      },
      {
        "command": "karateDebug.logout",
        "title": "Karate Debug: Sign Out"
      },
      {
        "command": "karateDebug.upgrade",
        "title": "Karate Debug: Upgrade to Pro"
      },
      {
        "command": "karateDebug.manageSubscription",
        "title": "Karate Debug: Manage Subscription"
      },
      {
        "command": "karateDebug.showLicenseInfo",
        "title": "Karate Debug: License Info"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "karate-explorer",
          "title": "Karate",
          "icon": "resources/karate-dark.svg"
        }
      ]
    },
    "views": {
      "karate-explorer": [
        {
          "id": "karateFeatures",
          "name": "Features"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "karateDebug.refreshFeatures",
          "when": "view == karateFeatures",
          "group": "navigation"
        },
        {
          "command": "karateDebug.openSettings",
          "when": "view == karateFeatures",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "karateDebug.debugEntireFeature",
          "when": "view == karateFeatures && viewItem == feature",
          "group": "inline"
        },
        {
          "command": "karateDebug.debugFeature",
          "when": "view == karateFeatures && viewItem == scenario",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "package:dev": "node scripts/set-build-env.js dev && npm run compile && vsce package --out karate-debug-dev.vsix && node scripts/set-build-env.js prod",
    "package:prod": "node scripts/set-build-env.js prod && npm run compile && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/mocha": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "mocha": "^11.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.64.0",
    "@vscode/debugprotocol": "^1.64.0",
    "ws": "^8.19.0"
  }
}
