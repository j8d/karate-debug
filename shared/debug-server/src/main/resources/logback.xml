<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender - VS Code/IntelliJ captures stdout -->
    <!-- Uses custom encoder to add [karate.log] prefix to karate.log() output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.j8d.karate.debug.KarateLogEncoder">
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Log breakpoint appender - monitors logs for breakpoint patterns -->
    <appender name="LOG_BREAKPOINT" class="com.j8d.karate.debug.LogBreakpointAppender"/>

    <!-- Our debug server classes - level set programmatically via setLogLevel() -->
    <logger name="com.j8d.karate.debug"/>

    <!-- Karate framework - level set programmatically via setLogLevel() -->
    <logger name="com.intuit.karate"/>

    <!-- JSON Path - WARN to reduce noise from path evaluation -->
    <logger name="com.jayway.jsonpath" level="WARN"/>

    <!-- HTTP client - WARN to reduce noise -->
    <logger name="org.apache.http" level="WARN"/>

    <!-- Thymeleaf - WARN to reduce noise -->
    <logger name="org.thymeleaf" level="WARN"/>

    <!-- GraalVM - WARN to reduce noise -->
    <logger name="org.graalvm" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOG_BREAKPOINT"/>
    </root>
</configuration>

