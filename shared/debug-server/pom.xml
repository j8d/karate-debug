<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.j8d.karate</groupId>
    <artifactId>karate-debug-server</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Karate Debug Server</name>
    <description>Debug Adapter Protocol server for Karate DSL testing</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Using Karate fork with GraalVM 25.0.2 for compatibility with chromeinspector/dap-tool -->
        <!-- See docs/KARATE-FORK-STRATEGY.md for details -->
        <karate.version>v1.5.2-j8d.1</karate.version>
        <!--
             GraalVM version for dap-tool dependency.
             Note: Karate 1.5.2 bundles GraalJS/polyglot 24.0.0, but we use dap-tool 25.0.2
             because it's the latest available version with the DAP server implementation.
             This version mismatch means we cannot use dap-tool's DAP server directly with
             Karate's polyglot engine (causes NoSuchMethodError). Instead, we use dap-tool
             only for bundling/availability purposes, while actual JS debugging is done via
             Chrome DevTools Protocol (CDP) with Karate's built-in GraalJS engine.
             See CrossLanguageStepIntoJsTest.java and GraalDapSourceTest.java for details.
        -->
        <graalvm.version>25.0.2</graalvm.version>
    </properties>

    <dependencies>
        <!-- Karate Core - using instrumented fork from j8d-org for CI debugging -->
        <dependency>
            <groupId>com.github.j8d-org.karate</groupId>
            <artifactId>karate-core</artifactId>
            <version>${karate.version}</version>
        </dependency>

        <!-- JSON processing for DAP messages - included in JAR -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.2</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>

        <!-- Logback - needed for DapOutputAppender which extends AppenderBase -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.27</version>
            <scope>provided</scope>
        </dependency>

        <!-- GraalVM Chrome Inspector - enables JavaScript debugging via Chrome DevTools Protocol -->
        <!-- Must match the GraalJS version used by Karate (24.0.0 for Karate 1.5.2) -->
        <dependency>
            <groupId>org.graalvm.tools</groupId>
            <artifactId>chromeinspector-tool</artifactId>
            <version>${graalvm.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- GraalVM DAP Tool - enables JavaScript debugging via Debug Adapter Protocol -->
        <!-- Bundled in the debug server JAR so it's available when spawning child processes -->
        <dependency>
            <groupId>org.graalvm.tools</groupId>
            <artifactId>dap-tool</artifactId>
            <version>${graalvm.version}</version>
        </dependency>

        <!-- WebSocket client for Chrome DevTools Protocol (CDP) communication -->
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.6.0</version>
        </dependency>

        <!-- CFR Decompiler - for decompiling Java bytecode on-the-fly -->
        <dependency>
            <groupId>org.benf</groupId>
            <artifactId>cfr</artifactId>
            <version>0.152</version>
        </dependency>

        <!-- JUnit 5 for testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- JitPack repository for instrumented Karate fork -->
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- Build thin JAR with only our code + gson -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>com.google.code.gson:gson</include>
                                    <include>org.java-websocket:Java-WebSocket</include>
                                    <include>org.benf:cfr</include>
                                    <!-- GraalVM DAP tool and its dependencies for JS debugging -->
                                    <include>org.graalvm.tools:dap-tool</include>
                                    <include>org.graalvm.truffle:truffle-dsl-processor</include>
                                    <include>org.graalvm.shadowed:json</include>
                                </includes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.j8d.karate.debug.DebugServer</mainClass>
                                </transformer>
                            </transformers>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire for JUnit 5 tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
        </plugins>
    </build>
</project>
